/.build/

# The patched Swift Bundler, cloned and built by scripts/swift-bundler/build.sh on the branches that have
# it. Outside /.build/ so that a clean rebuild does not throw it away, and ignored here because it is a 2 GB
# checkout that has already been staged by accident once.
/.tools/
/.swiftpm/
/.swiftlint.cache/
/.cache/
.DS_Store
client_secret_*.json
.vscode/
config.*
/Tests/Bench/device_register_snapshot.json
/logs/
__pycache__/
.claude/

# Written by scripts/generate-credentials.sh from the Google console download. Never committed:
# a release build and a developer build point at different projects, and this repo stays publishable.
# Unanchored: the generator writes it under Sources/FacetApp/Resources, and a copy that lands anywhere
# else in the tree carries the same live client_secret and is ignored on the same terms.
google-client.json

# Built by scripts/package.sh: a disk image to send somebody, not something to commit.
/dist/
